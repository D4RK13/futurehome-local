            { "id": "heat", "title": { "en": "Heat", "no": "Varme" } },
            { "id": "home", "title": { "en": "Home", "no": "Hjemme" } },
            { "id": "away", "title": { "en": "Away", "no": "Borte" } },
            { "id": "auto", "title": { "en": "Auto (week program)", "no": "Auto (ukeprogram)" } }
          ]
        }
      ]
    },
