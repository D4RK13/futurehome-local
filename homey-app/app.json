              "label": {
                "en": "Hysteresis (°C)",
                "no": "Hysterese (°C)"
              },
              "hint": {
                "en": "How far the temperature may drift from the target before the heating switches on or off. A higher value gives fewer switches.",
                "no": "Hvor langt temperaturen kan avvike fra ønsket temperatur før varmen slår seg på eller av. Høyere verdi gir færre koblinger."
              },
              "value": 2,
