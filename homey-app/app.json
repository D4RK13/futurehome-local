          "children": [
            {
              "id": "open_window_detection",
              "type": "checkbox",
              "label": {
                "en": "Open window detection",
                "no": "Åpent vindu-funksjon"
              },
              "hint": {
                "en": "Stops heating when the temperature drops quickly, e.g. when a window is opened.",
                "no": "Slår av varmen når temperaturen faller raskt, f.eks. når et vindu åpnes."
              },
              "value": true
            },
