              "type": "label",
              "label": {
                "en": "Sensor type",
                "no": "Følertype"
              },
              "hint": {
                "en": "Which sensor the thermostat follows. Set it on the thermostat itself (menu setting 1). Read only here, because it decides the floor protection.",
                "no": "Hvilken føler termostaten styrer etter. Stilles på selve termostaten (menyinnstilling 1). Kan bare leses her, fordi den styrer gulvvernet."
              },
              "value": "–"
